<?xml version="1.0"?>
<package format="3">
  <name>m1_scope_costmap_layer</name>
  <version>0.1.0</version>
  <description>Nav2 costmap layer for matched SCOPE prediction and uncertainty grids.</description>
  <maintainer email="user@example.com">Rosmaster user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_costmap_2d</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/scope_layer.xml"/>
  </export>
</package>
